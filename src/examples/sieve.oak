// Sieve of Eratosthenes up to 200,000: arrays and nested loops.
int n = 200000;
boolean[] composite = new boolean[n + 1];
int count = 0;
for (int i = 2; i <= n; i++) {
    if (!composite[i]) {
        count++;
        for (int j = i * 2; j <= n; j = j + i) {
            composite[j] = true;
        }
    }
}
System.out.println(count);

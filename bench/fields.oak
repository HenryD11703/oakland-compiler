// Method calls and field reads and writes on a class, 300,000 times.
class Counter {
    int total;
    int steps;

    void add(int i) {
        total = total + i % 3;
        steps++;
    }
}
Counter c = new Counter();
for (int i = 0; i < 300000; i++) {
    c.add(i);
}
System.out.println(c.total, c.steps);

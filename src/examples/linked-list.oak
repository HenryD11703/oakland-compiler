// Objects that point to objects: a linked list built from two classes.

class Node {
    int value;
    Node next;

    Node(int value) {
        this.value = value;
    }
}

class LinkedList {
    Node head;
    int size;

    void add(int value) {
        Node node = new Node(value);
        if (head == null) {
            head = node;
        } else {
            Node last = head;
            while (last.next != null) {
                last = last.next;
            }
            last.next = node;
        }
        size++;
    }

    int sum() {
        int total = 0;
        Node current = head;
        while (current != null) {
            total += current.value;
            current = current.next;
        }
        return total;
    }

    void reverse() {
        Node previous = null;
        Node current = head;
        while (current != null) {
            Node after = current.next;
            current.next = previous;
            previous = current;
            current = after;
        }
        head = previous;
    }

    void print() {
        string text = "";
        Node current = head;
        while (current != null) {
            text = text + current.value + " ";
            current = current.next;
        }
        System.out.println(text);
    }
}

LinkedList list = new LinkedList();
for (int i = 1; i <= 5; i++) {
    list.add(i * i);
}
list.print();
System.out.println("size", list.size, "sum", list.sum());
list.reverse();
list.print();

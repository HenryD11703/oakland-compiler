// if, while, for, for-each and switch.

int score = 73;
if (score >= 90) {
    System.out.println("grade A");
} else if (score >= 70) {
    System.out.println("grade B");
} else {
    System.out.println("grade C");
}

int total = 0;
int n = 1;
while (n <= 5) {
    total += n;
    n++;
}
System.out.println("sum of 1..5 =", total);

for (int i = 1; i <= 10; i++) {
    if (i % 2 == 0) {
        continue;       // skip the even numbers
    }
    if (i > 7) {
        break;          // stop after 7
    }
    System.out.println("odd:", i);
}

string[] days = {"Mon", "Tue", "Wed"};
for (string day : days) {
    System.out.println("day", day);
}

// switch falls through until a break.
int number = 2;
switch (number) {
    case 1:
        System.out.println("one");
        break;
    case 2:
        System.out.println("two");
    case 3:
        System.out.println("three (reached by falling through)");
        break;
    default:
        System.out.println("something else");
}
